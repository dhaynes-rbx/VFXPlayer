{
  "name": "VFXPlayer",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Client": {
        "$path": "src/ReplicatedStorage/Client"
      },
      "Shared": {
        "$className": "Folder",
        "VFXPlayer": {
          "$path": "src/shared/VFXPlayer"
        }
      }
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      },
      "VFXExamples": {
        "$path": "src/examples"
      }
    }
  }
}